<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Normalizador Estándar de Bases de Datos de Marketing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
    </style>
</head>
<body class="h-full flex flex-col justify-between antialiased">

    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40 px-6 py-4">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2.5 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl shadow-lg shadow-indigo-500/20">
                    <i data-lucide="database" class="w-6 h-6 text-white animate-pulse"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                        DataNorm <span class="text-xs bg-indigo-500/20 text-indigo-400 px-2 py-0.5 rounded-full font-semibold border border-indigo-500/30">v5.1</span>
                    </h1>
                    <p class="text-xs text-slate-400">Conversor con Edición de Resultados y Nombres de Archivo Inteligentes</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <button onclick="loadSampleData('meta')" class="px-3.5 py-2 text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-lg border border-slate-700 transition flex items-center gap-2 cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
                    Cargar Demo Meta
                </button>
                <button onclick="loadSampleData('google')" class="px-3.5 py-2 text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-lg border border-slate-700 transition flex items-center gap-2 cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
                    Cargar Demo Google
                </button>
                <button onclick="resetApp()" class="p-2 text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg border border-slate-700 transition cursor-pointer" title="Reiniciar aplicación">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
        
        <div class="bg-gradient-to-r from-slate-800 via-slate-800 to-indigo-950/40 border border-slate-700/60 rounded-2xl p-6 relative overflow-hidden shadow-xl">
            <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="flex items-start gap-4">
                <div class="p-3 bg-indigo-500/10 text-indigo-400 rounded-xl border border-indigo-500/20 shrink-0">
                    <i data-lucide="sparkles" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-white mb-1">Normalización Interactiva Inteligente</h2>
                    <p class="text-sm text-slate-300 leading-relaxed max-w-4xl">
                        Sube tu base de datos de <strong>Meta Ads</strong> o <strong>Google Ads</strong>. El sistema filtrará filas sin rendimiento relevante. Ahora puedes **editar de forma directa la columna de "Resultados" de cualquier fila** en la tabla de previsualización para corregir desviaciones o conversiones atribuidas fuera de plataforma. El costo promedio por adquisición se recalcula al instante.
                    </p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 flex flex-col justify-between shadow-lg relative group hover:border-blue-500/50 transition-colors">
                <div class="absolute top-4 right-4 text-blue-500 opacity-20 group-hover:opacity-100 transition-opacity">
                    <i data-lucide="infinity" class="w-8 h-8"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-400 border border-blue-500/20 shadow-inner">
                            <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 12c-1.8-2.5-3.6-4-5.5-4a3.5 3.5 0 1 0 0 7c1.9 0 3.7-1.5 5.5-4Zm0 0c1.8 2.5 3.6 4 5.5 4a3.5 3.5 0 1 0 0-7c-1.9 0-3.7 1.5-5.5 4Z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-white">Canal: Meta Ads</h3>
                            <p class="text-xs text-slate-400">Normalizador y Editor Interactivo de Conversiones</p>
                        </div>
                    </div>

                    <div class="border-2 border-dashed border-slate-700 hover:border-blue-500 rounded-xl p-6 text-center cursor-pointer transition-colors relative" id="drop-zone-meta">
                        <input type="file" id="file-meta" accept=".csv" class="hidden" onchange="handleFileSelect('meta')">
                        <label for="file-meta" class="cursor-pointer flex flex-col items-center justify-center space-y-2">
                            <div class="p-3 bg-slate-900 rounded-full text-slate-400 group-hover:text-blue-400 transition-colors" id="icon-meta-container">
                                <i data-lucide="upload-cloud" class="w-6 h-6" id="icon-meta"></i>
                            </div>
                            <p class="text-sm font-semibold text-slate-300" id="label-meta">Sube o arrastra tu CSV de Meta Ads</p>
                        </label>
                    </div>

                    <div id="status-meta" class="mt-4 hidden bg-slate-900/60 rounded-xl p-4 border border-slate-800 text-xs space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-slate-400">Archivo de Meta detectado:</span>
                            <span class="font-semibold text-blue-400" id="filename-meta">-</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-slate-400">Filas activas listas para edición:</span>
                            <span class="font-mono bg-emerald-950 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded font-bold" id="rows-active-meta">0</span>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex gap-2">
                    <button id="btn-process-meta" onclick="processData('meta')" disabled class="flex-1 bg-slate-700 text-slate-400 font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2">
                        <i data-lucide="play" class="w-4 h-4"></i>1. Cargar y Procesar Meta Ads
                    </button>
                </div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 flex flex-col justify-between shadow-lg relative group hover:border-amber-500/50 transition-colors">
                <div class="absolute top-4 right-4 text-amber-500 opacity-20 group-hover:opacity-100 transition-opacity">
                    <i data-lucide="search" class="w-8 h-8"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-400 border border-amber-500/20 shadow-inner">
                            <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 3h14c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2z" />
                                <path d="m16 8-8 8" />
                                <path d="M12 8h4v4" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-white">Canal: Google Ads</h3>
                            <p class="text-xs text-slate-400">Conversor y Editor Interactivo de Conversiones</p>
                        </div>
                    </div>

                    <div class="border-2 border-dashed border-slate-700 hover:border-amber-500 rounded-xl p-6 text-center cursor-pointer transition-colors relative" id="drop-zone-google">
                        <input type="file" id="file-google" accept=".csv" class="hidden" onchange="handleFileSelect('google')">
                        <label for="file-google" class="cursor-pointer flex flex-col items-center justify-center space-y-2">
                            <div class="p-3 bg-slate-900 rounded-full text-slate-400 group-hover:text-amber-400 transition-colors" id="icon-google-container">
                                <i data-lucide="upload-cloud" class="w-6 h-6" id="icon-google"></i>
                            </div>
                            <p class="text-sm font-semibold text-slate-300" id="label-google">Sube o arrastra tu CSV de Google Ads</p>
                        </label>
                    </div>

                    <div id="status-google" class="mt-4 hidden bg-slate-900/60 rounded-xl p-4 border border-slate-800 text-xs space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-slate-400">Archivo de Google detectado:</span>
                            <span class="font-semibold text-amber-400" id="filename-google">-</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-slate-400">Filas activas listas para edición:</span>
                            <span class="font-mono bg-emerald-950 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded font-bold" id="rows-active-google">0</span>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex gap-2">
                    <button id="btn-process-google" onclick="processData('google')" disabled class="flex-1 bg-slate-700 text-slate-400 font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2">
                        <i data-lucide="play" class="w-4 h-4"></i>1. Cargar y Procesar Google Ads
                    </button>
                </div>
            </div>

        </div>

        <div id="notification-bar" class="hidden p-4 rounded-xl border flex items-center gap-3 transition-all duration-300 shadow-xl">
            <div class="p-2 rounded-lg" id="notification-icon-bg">
                <i id="notification-icon" class="w-5 h-5 text-white"></i>
            </div>
            <div class="flex-1">
                <p id="notification-message" class="text-sm font-semibold text-white"></p>
                <p id="notification-detail" class="text-xs text-slate-400"></p>
            </div>
            <button onclick="hideNotification()" class="text-slate-400 hover:text-white cursor-pointer p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="bg-slate-800/40 border border-slate-700/80 rounded-2xl p-6 space-y-6 shadow-xl relative">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i data-lucide="edit-3" class="w-5 h-5 text-indigo-400"></i> 2. Previsualización y Edición de Datos Normalizados
                    </h3>
                    <p class="text-xs text-slate-400">Modifica la columna de 'Resultados' directamente en la tabla. El Costo por Resultados se ajustará dinámicamente.</p>
                </div>

                <div class="flex bg-slate-900 p-1 rounded-xl border border-slate-800">
                    <button id="tab-meta" onclick="switchPreviewTab('meta')" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 text-white shadow-sm transition cursor-pointer">
                        Meta Ads
                    </button>
                    <button id="tab-google" onclick="switchPreviewTab('google')" class="px-4 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition cursor-pointer">
                        Google Ads
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto w-full border border-slate-800 rounded-xl bg-slate-950/60 max-h-96">
                <table class="min-w-full divide-y divide-slate-800 text-xs text-left">
                    <thead class="bg-slate-900 text-slate-300 uppercase tracking-wider sticky top-0 z-10 font-bold" id="preview-table-header"></thead>
                    <tbody id="preview-table-body" class="divide-y divide-slate-800/60 text-slate-300">
                        <tr><td class="px-4 py-12 text-center text-slate-500">Sube y procesa un archivo o carga los demos de prueba arriba para comenzar a editar.</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-4 border-t border-slate-800/60">
                <div class="text-xs text-slate-400 font-medium" id="preview-status-text">Mostrando 0 registros</div>
                
                <button id="btn-final-convert" onclick="triggerFinalConversion()" class="w-full sm:w-auto px-6 py-3.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm rounded-xl transition shadow-lg shadow-emerald-950/40 flex items-center justify-center gap-2.5 cursor-pointer opacity-50 cursor-not-allowed" disabled>
                    <i data-lucide="check-check" class="w-5 h-5"></i>
                    3. Confirmar Cambios y Finalizar Conversión
                </button>
            </div>
        </div>

    </main>

    <footer class="border-t border-slate-800 bg-slate-950 py-6 text-center text-xs text-slate-500">
        <p>© 2026 Normalizador Profesional de Datos de Marketing - Procesamiento 100% Seguro y Local</p>
    </footer>

    <script>
        const appState = {
            meta: { rawContent: null, fileName: "", processedData: null },
            google: { rawContent: null, fileName: "", processedData: null },
            currentTab: 'meta'
        };

        const META_OFICIAL_COLUMNS = [
            "Inicio del reporte", "Fin del reporte", "Nombre de la campaña", "Resultados",
            "Alcance", "Frecuencia", "Costo por resultados", "Importe gastado (MXN)",
            "Impresiones", "CPM (costo por mil impresiones) (MXN)", "Clics (todos)", "CTR (todos)", "CPC (todos) (MXN)"
        ];

        const GOOGLE_OFICIAL_COLUMNS = [
            "Nombre de la campaña", "Impresiones", "Porcentaje de clics", "Clics (todos)",
            "CPC (todos) (MXN)", "Importe gastado (MXN)", "CTR (todos)", "Resultados",
            "Costo por resultados", "Tipo de campaña"
        ];

        const MetaColumnSynonyms = {
            "Inicio del reporte": ["inicio del reporte", "reporting start", "start date", "fecha de inicio", "start", "desde"],
            "Fin del reporte": ["fin del reporte", "reporting end", "end date", "fecha de fin", "end", "hasta"],
            "Nombre de la campaña": ["nombre de la campaña", "campaign name", "campaña", "campaign_name", "campana"],
            "Resultados": ["resultados", "results", "conversions", "conversiones", "actions", "acciones"],
            "Alcance": ["alcance", "reach"],
            "Frecuencia": ["frecuencia", "frequency"],
            "Costo por resultados": ["costo por resultados", "cost per results", "cost per result", "costo por resultado", "cpr"],
            "Importe gastado (MXN)": ["importe gastado (mxn)", "importe gastado", "amount spent", "costo", "gasto", "gasto total", "amount spent (mxn)", "spend"],
            "Impresiones": ["impresiones", "impressions", "impr.", "impr"],
            "CPM (costo por mil impresiones) (MXN)": ["cpm", "cpm (costo por mil impresiones) (mxn)", "cost per 1,000 impressions"],
            "Clics (todos)": ["clics (todos)", "clics", "clicks", "clicks (all)", "clics (todos)"],
            "CTR (todos)": ["ctr", "ctr (todos)", "ctr (all)"],
            "CPC (todos) (MXN)": ["cpc", "cpc (todos) (mxn)", "prom. cpc", "cost per click", "cpc (all)"]
        };

        const GoogleInputColumnSynonyms = {
            "Nombre de la campaña": ["campaña", "campaign", "nombre de la campaña", "campaign name", "campana"],
            "Impresiones": ["impr.", "impresiones", "impressions", "impr"],
            "Porcentaje de clics": ["porcentaje de interacción", "porcentaje de clics", "interaction rate", "click share", "porcentaje clics"],
            "Clics (todos)": ["clics", "clicks", "clics (todos)", "clicks (all)"],
            "CPC (todos) (MXN)": ["prom. cpc", "promedio cpc", "average cpc", "cpc (todos) (mxn)", "avg. cpc"],
            "Importe gastado (MXN)": ["costo", "cost", "gasto", "importe gastado (mxn)", "gasto total", "spent"],
            "CTR (todos)": ["ctr", "ctr (todos)", "click through rate"],
            "Resultados": ["conversiones", "conversions", "resultados", "conversiones total"],
            "Costo por resultados": ["costo/conv.", "costo por resultados", "cost per conv.", "cost / conv."],
            "Tipo de campaña": ["tipo de campaña", "campaign type", "tipo campaña"]
        };

        function setupDragAndDrop(platform) {
            const dropZone = document.getElementById(`drop-zone-${platform}`);
            
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropZone.classList.add(platform === 'meta' ? 'border-blue-500' : 'border-amber-500');
                    dropZone.classList.add('bg-slate-800');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropZone.classList.remove(platform === 'meta' ? 'border-blue-500' : 'border-amber-500');
                    dropZone.classList.remove('bg-slate-800');
                }, false);
            });

            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length > 0) {
                    const inputElement = document.getElementById(`file-${platform}`);
                    inputElement.files = files;
                    handleFileSelect(platform);
                }
            }, false);
        }

        window.onload = function() {
            setupDragAndDrop('meta');
            setupDragAndDrop('google');
            lucide.createIcons();
        };

        function showNotification(type, message, detail = "") {
            const bar = document.getElementById('notification-bar');
            const icon = document.getElementById('notification-icon');
            const iconBg = document.getElementById('notification-icon-bg');
            const msgEl = document.getElementById('notification-message');
            const detEl = document.getElementById('notification-detail');

            msgEl.innerText = message;
            detEl.innerText = detail;

            if (type === 'success') {
                bar.className = "p-4 rounded-xl border border-emerald-500/30 bg-emerald-950/30 flex items-center gap-3 shadow-xl";
                iconBg.className = "p-2 rounded-lg bg-emerald-500/20 text-emerald-400";
                icon.setAttribute('data-lucide', 'check-circle-2');
            } else if (type === 'error') {
                bar.className = "p-4 rounded-xl border border-red-500/30 bg-red-950/30 flex items-center gap-3 shadow-xl";
                iconBg.className = "p-2 rounded-lg bg-red-500/20 text-red-400";
                icon.setAttribute('data-lucide', 'alert-triangle');
            } else {
                bar.className = "p-4 rounded-xl border border-blue-500/30 bg-blue-950/30 flex items-center gap-3 shadow-xl";
                iconBg.className = "p-2 rounded-lg bg-blue-500/20 text-blue-400";
                icon.setAttribute('data-lucide', 'info');
            }

            bar.classList.remove('hidden');
            lucide.createIcons();
            
            setTimeout(() => {
                hideNotification();
            }, 8000);
        }

        function hideNotification() {
            document.getElementById('notification-bar').classList.add('hidden');
        }

        function handleFileSelect(platform) {
            const file = document.getElementById(`file-${platform}`).files[0];
            if (!file) return;
            appState[platform].fileName = file.name;
            const reader = new FileReader();
            reader.onload = function(e) {
                appState[platform].rawContent = e.target.result;
                document.getElementById(`status-${platform}`).classList.remove('hidden');
                document.getElementById(`filename-${platform}`).innerText = file.name;
                const btn = document.getElementById(`btn-process-${platform}`);
                btn.removeAttribute('disabled');
                btn.className = "flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-pointer flex items-center justify-center gap-2";
                
                document.getElementById(`label-${platform}`).innerText = `¡CSV Cargado exitosamente!`;
                const iconContainer = document.getElementById(`icon-${platform}-container`);
                iconContainer.className = "p-3 bg-emerald-500/20 rounded-full text-emerald-400";
                document.getElementById(`icon-${platform}`).setAttribute('data-lucide', 'file-check');
                lucide.createIcons();

                showNotification('success', 'Archivo cargado', 'Haz clic en el botón "1. Cargar y Procesar" para habilitar la edición de filas.');
            };
            reader.readAsText(file, "UTF-8");
        }

        function loadSampleData(platform) {
            if (platform === 'meta') {
                appState.meta.rawContent = `"Reporting Start","Reporting End","Campaign Name","Reach","Impressions","Amount Spent (MXN)","Link Clicks","Results","Frequency"\n"2026-05-01","2026-05-31","Meta - Campaña Conversiones Pro","4500","6820","1450.50","120","12","1.51"\n"2026-05-01","2026-05-31","Meta - Campaña Inactiva","0","0","0.00","0","0","0.0"\n"2026-05-01","2026-05-31","Meta - Lead Generation Camp","18000","24500","3890.00","480","25","1.36"`;
                appState.meta.fileName = "Meta - Campaña Conversiones Pro.csv";
            } else {
                appState.google.rawContent = `,,,,,,,,,\n,,,,,,,,,\nCampaña,Impr.,Porcentaje de interacción,Clics,Prom. CPC,Costo,CTR,Conversiones,Costo/conv.,Tipo de campaña\n"SEARCH_BrandMéxico","2450",8.50%,210,12.50,2625.00,8.50%,15,175.00,Búsqueda\n"PMAX_TráficoEspecializado","18900",4.10%,774,4.20,3250.80,4.10%,5,650.16,Performance Max\n"SEARCH_CeroGasto_Eliminar","0",0.00%,0,0.00,0.00,0.00%,0,0.00,Búsqueda`;
                appState.google.fileName = "Google - BrandMéxico.csv";
            }
            
            document.getElementById(`status-${platform}`).classList.remove('hidden');
            document.getElementById(`filename-${platform}`).innerText = appState[platform].fileName;
            const btn = document.getElementById(`btn-process-${platform}`);
            btn.removeAttribute('disabled');
            btn.className = "flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-pointer flex items-center justify-center gap-2";
            
            document.getElementById(`label-${platform}`).innerText = `¡Demo listo para procesar!`;
            const iconContainer = document.getElementById(`icon-${platform}-container`);
            iconContainer.className = "p-3 bg-indigo-500/20 rounded-full text-indigo-400";
            document.getElementById(`icon-${platform}`).setAttribute('data-lucide', 'file-check');
            lucide.createIcons();

            showNotification('info', `Set de Datos Demo de ${platform.toUpperCase()} cargado en memoria.`);
        }

        function cleanNumber(val) {
            if (!val) return 0;
            let clean = val.toString().replace(/[\$\s%MXN]/gi, '').replace(/"/g, '').replace(/,/g, '');
            let parsed = parseFloat(clean);
            return isNaN(parsed) ? 0 : parsed;
        }

        function parseCSV(text) {
            let lines = []; let row = [""]; let inQuotes = false;
            for (let i = 0; i < text.length; i++) {
                let c = text[i]; let next = text[i+1];
                if (c === '"') { 
                    if (inQuotes && next === '"') { row[row.length - 1] += '"'; i++; } 
                    else { inQuotes = !inQuotes; } 
                }
                else if (c === ',' && !inQuotes) { row.push(''); }
                else if ((c === '\r' || c === '\n') && !inQuotes) { 
                    if (c === '\r' && next === '\n') { i++; } 
                    lines.push(row); 
                    row = ['']; 
                }
                else { row[row.length - 1] += c; }
            }
            if (row.length > 1 || row[0] !== '') lines.push(row);
            return lines;
        }

        function processData(platform) {
            const rawContent = appState[platform].rawContent;
            if (!rawContent) {
                showNotification('error', 'Error en procesamiento', 'No hay datos cargados para este canal.');
                return;
            }

            const rawRows = parseCSV(rawContent);
            let headerRowIndex = 0;
            for (let i = 0; i < rawRows.length; i++) {
                if (rawRows[i].join('').trim().length > 0) {
                    if (rawRows[i].some(cell => {
                        const cellLower = cell.toLowerCase();
                        return cellLower.includes('camp') || cellLower.includes('cost') || cellLower.includes('impr') || cellLower.includes('clic');
                    })) {
                        headerRowIndex = i; 
                        break;
                    }
                }
            }

            const rawHeaders = rawRows[headerRowIndex].map(h => h.trim().toLowerCase());
            const indexMap = {};
            const targetColumns = platform === 'meta' ? META_OFICIAL_COLUMNS : GOOGLE_OFICIAL_COLUMNS;
            const targetSynonyms = platform === 'meta' ? MetaColumnSynonyms : GoogleInputColumnSynonyms;

            for (const oficialCol of targetColumns) {
                indexMap[oficialCol] = -1;
                const synonyms = targetSynonyms[oficialCol];
                for (let i = 0; i < rawHeaders.length; i++) {
                    const cleanRawHeader = rawHeaders[i].trim();
                    if (synonyms.includes(cleanRawHeader) || cleanRawHeader === oficialCol.toLowerCase()) {
                        indexMap[oficialCol] = i; 
                        break;
                    }
                }
            }

            const cleanRows = [];
            for (let r = headerRowIndex + 1; r < rawRows.length; r++) {
                const row = rawRows[r];
                if (row.length === 0 || row.join('').trim() === '') continue;
                if (row.join('').toLowerCase().includes('total') || row.join('').toLowerCase().includes('resumen') || row.join('').toLowerCase().includes('summary')) continue;

                const item = {};
                for (const col of targetColumns) {
                    const index = indexMap[col];
                    item[col] = (index !== -1 && row[index] !== undefined) ? row[index].trim() : "";
                }

                let impr = cleanNumber(item["Impresiones"]);
                let clics = cleanNumber(item["Clics (todos)"]);
                let costo = cleanNumber(item["Importe gastado (MXN)"]);
                let conv = cleanNumber(item["Resultados"]);

                // Filtrado Estricto de Ceros
                if (impr === 0 || clics === 0 || costo === 0) continue;

                if (platform === 'meta') {
                    item["Inicio del reporte"] = item["Inicio del reporte"] || new Date().toISOString().split('T')[0];
                    item["Fin del reporte"] = item["Fin del reporte"] || new Date().toISOString().split('T')[0];
                    item["Nombre de la campaña"] = item["Nombre de la campaña"] || "Campaña Meta Desconocida";
                    item["Resultados"] = conv;
                    item["Alcance"] = cleanNumber(item["Alcance"]) || impr;
                    item["Frecuencia"] = (cleanNumber(item["Frecuencia"]) || 1.0).toFixed(2);
                    item["Costo por resultados"] = (conv > 0 ? (costo / conv) : 0).toFixed(2);
                    item["Importe gastado (MXN)"] = costo.toFixed(2);
                    item["Impresiones"] = impr;
                    item["CPM (costo por mil impresiones) (MXN)"] = ((costo / impr) * 1000).toFixed(2);
                    item["Clics (todos)"] = clics;
                    item["CTR (todos)"] = ((clics / impr) * 100).toFixed(2) + "%";
                    item["CPC (todos) (MXN)"] = (costo / clics).toFixed(2);
                } else {
                    item["Nombre de la campaña"] = item["Nombre de la campaña"] || "Campaña Google Desconocida";
                    item["Impresiones"] = impr;
                    item["Porcentaje de clics"] = item["Porcentaje de clics"] || (((clics / impr) * 100).toFixed(2) + "%");
                    item["Clics (todos)"] = clics;
                    item["CPC (todos) (MXN)"] = (costo / clics).toFixed(2);
                    item["Importe gastado (MXN)"] = costo.toFixed(2);
                    item["CTR (todos)"] = item["CTR (todos)"] || (((clics / impr) * 100).toFixed(2) + "%");
                    item["Resultados"] = conv;
                    item["Costo por resultados"] = (conv > 0 ? (costo / conv) : 0).toFixed(2);
                    item["Tipo de campaña"] = item["Tipo de campaña"] || "Búsqueda";
                }
                cleanRows.push(item);
            }

            appState[platform].processedData = cleanRows;
            document.getElementById(`rows-active-${platform}`).innerText = cleanRows.length;

            switchPreviewTab(platform);
            enableConversionFlow();
            showNotification('success', `Datos procesados. Modifica las celdas de "Resultados" abajo si lo requieres.`);
        }

        function updateConversionValue(platform, index, value) {
            if (appState[platform].processedData && appState[platform].processedData[index]) {
                const row = appState[platform].processedData[index];
                const cleanConv = parseInt(value);
                const safeConv = isNaN(cleanConv) || cleanConv < 0 ? 0 : cleanConv;
                
                row["Resultados"] = safeConv;
                
                const costoFloat = parseFloat(row["Importe gastado (MXN)"]) || 0;
                
                // Recálculo automático de Costo por Resultados
                const nuevoCostoResultados = safeConv > 0 ? (costoFloat / safeConv).toFixed(2) : "0.00";
                row["Costo por resultados"] = nuevoCostoResultados;
                
                // Actualizar la celda de la interfaz inmediatamente sin perder el foco del input
                const costoCell = document.getElementById(`costoconv-display-${platform}-${index}`);
                if (costoCell) {
                    costoCell.innerText = `$${nuevoCostoResultados}`;
                    costoCell.classList.add('text-emerald-400');
                    setTimeout(() => costoCell.classList.remove('text-emerald-400'), 1000);
                }
            }
        }

        function enableConversionFlow() {
            const btn = document.getElementById('btn-final-convert');
            btn.removeAttribute('disabled');
            btn.className = "w-full sm:w-auto px-6 py-3.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm rounded-xl transition shadow-lg shadow-emerald-950/40 flex items-center justify-center gap-2.5 cursor-pointer opacity-100";
        }

        function switchPreviewTab(platform) {
            appState.currentTab = platform;
            
            const activeTabClass = "px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 text-white shadow-sm transition cursor-pointer border border-slate-700/50";
            const inactiveTabClass = "px-4 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition cursor-pointer";
            
            document.getElementById('tab-meta').className = platform === 'meta' ? activeTabClass : inactiveTabClass;
            document.getElementById('tab-google').className = platform === 'google' ? activeTabClass : inactiveTabClass;
            
            renderTable();
        }

        function renderTable() {
            const h = document.getElementById('preview-table-header');
            const body = document.getElementById('preview-table-body');
            const platform = appState.currentTab;
            const data = appState[platform].processedData;
            
            const cols = platform === 'meta' ? META_OFICIAL_COLUMNS : GOOGLE_OFICIAL_COLUMNS;
            h.innerHTML = `<tr>${cols.map(c => `<th class="px-4 py-3 border-b border-slate-800 font-bold text-slate-200">${c}</th>`).join('')}</tr>`;

            if (!data || data.length === 0) {
                body.innerHTML = `<tr><td colspan="${cols.length}" class="px-4 py-12 text-center text-slate-500">Ningún archivo procesado para este canal de adquisición.</td></tr>`;
                document.getElementById('preview-status-text').innerText = "Mostrando 0 registros";
                return;
            }

            body.innerHTML = "";
            data.forEach((row, rowIndex) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/40 transition-colors";

                cols.forEach(col => {
                    const td = document.createElement('td');
                    td.className = "px-4 py-3 border-b border-slate-800/50 text-slate-300 font-medium whitespace-nowrap";

                    // Edición habilitada en ambos canales
                    if (col === "Resultados") {
                        td.innerHTML = `
                            <div class="flex items-center space-x-1">
                                <input type="number" min="0" value="${row[col]}" 
                                    oninput="updateConversionValue('${platform}', ${rowIndex}, this.value)" 
                                    class="w-20 bg-slate-900 border border-slate-700 hover:border-slate-500 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded px-2 py-1 text-center font-bold text-white transition-all outline-none">
                            </div>
                        `;
                    } else if (col === "Costo por resultados") {
                        td.id = `costoconv-display-${platform}-${rowIndex}`;
                        td.innerText = `$${row[col]}`;
                        td.className += " font-semibold text-indigo-300";
                    } else {
                        if (col.includes("Importe gastado") || col.includes("Costo por resultados") || col.includes("CPC") || col.includes("CPM")) {
                            td.innerText = `$${row[col]}`;
                        } else if (col === "Impresiones" || col === "Clics (todos)" || col === "Alcance") {
                            td.innerText = parseInt(row[col]).toLocaleString('es-MX');
                        } else {
                            td.innerText = row[col];
                        }
                    }
                    tr.appendChild(td);
                });
                body.appendChild(tr);
            });

            document.getElementById('preview-status-text').innerText = `Mostrando ${data.length} registros estandarizados`;
        }

        function triggerFinalConversion() {
            const platform = appState.currentTab;
            const data = appState[platform].processedData;
            if (!data || data.length === 0) {
                showNotification('error', 'Error en exportación', 'No existen datos cargados para realizar la conversión.');
                return;
            }

            const targetColumns = platform === 'meta' ? META_OFICIAL_COLUMNS : GOOGLE_OFICIAL_COLUMNS;
            
            // Creación del cuerpo de datos CSV
            let csvRows = [];
            csvRows.push(targetColumns.join(','));

            data.forEach(item => {
                const values = targetColumns.map(col => {
                    const val = item[col] !== undefined ? item[col].toString() : '';
                    if (val.includes(',') || val.includes('"') || val.includes('\n')) {
                        return `"${val.replace(/"/g, '""')}"`;
                    }
                    return val;
                });
                csvRows.push(values.join(','));
            });

            const csvContent = csvRows.join('\n');
            const BOM = new Uint8Array([0xEF, 0xBB, 0xBF]); // UTF-8 BOM
            const blob = new Blob([BOM, csvContent], { type: 'text/csv;charset=utf-8;' });
            
            const link = document.createElement("a");
            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute("href", url);

                // LÓGICA DE RENOMBRADO AUTOMÁTICO SOLICITADA
                const originalName = appState[platform].fileName || `reporte_${platform}.csv`;
                const cleanName = originalName.replace(/\.csv$/i, '').trim();
                
                let firstWord = "";
                if (cleanName.includes('-')) {
                    // Si contiene un guion, tomar todo lo que está antes del primero
                    const beforeHyphen = cleanName.split('-')[0].trim();
                    // Extraer la primera palabra de ese segmento
                    firstWord = beforeHyphen.split(/[\s_]+/)[0];
                } else {
                    // Fallback: si no tiene guion, tomar la primera palabra del nombre original
                    firstWord = cleanName.split(/[\s_]+/)[0];
                }

                // Asegurar que no quede vacío por caracteres extraños
                if (!firstWord) {
                    firstWord = platform.toUpperCase();
                }

                const finalDownloadName = `${firstWord}_BASE_ESTANDARIZADA.csv`;
                
                link.setAttribute("download", finalDownloadName);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                showNotification('success', '¡Conversión Completada!', `Archivo exportado exitosamente como: ${finalDownloadName}`);
            }
        }

        function resetApp() {
            appState.meta = { rawContent: null, fileName: "", processedData: null };
            appState.google = { rawContent: null, fileName: "", processedData: null };
            appState.currentTab = 'meta';

            // Reiniciar UI Meta
            document.getElementById('status-meta').classList.add('hidden');
            document.getElementById('btn-process-meta').setAttribute('disabled', 'true');
            document.getElementById('btn-process-meta').className = "flex-1 bg-slate-700 text-slate-400 font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2";
            document.getElementById('file-meta').value = "";
            document.getElementById('label-meta').innerText = "Sube o arrastra tu CSV de Meta Ads";
            const iconMetaContainer = document.getElementById('icon-meta-container');
            iconMetaContainer.className = "p-3 bg-slate-900 rounded-full text-slate-400 group-hover:text-blue-400 transition-colors";
            document.getElementById('icon-meta').setAttribute('data-lucide', 'upload-cloud');

            // Reiniciar UI Google
            document.getElementById('status-google').classList.add('hidden');
            document.getElementById('btn-process-google').setAttribute('disabled', 'true');
            document.getElementById('btn-process-google').className = "flex-1 bg-slate-700 text-slate-400 font-semibold text-sm py-2.5 px-4 rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2";
            document.getElementById('file-google').value = "";
            document.getElementById('label-google').innerText = "Sube o arrastra tu CSV de Google Ads";
            const iconGoogleContainer = document.getElementById('icon-google-container');
            iconGoogleContainer.className = "p-3 bg-slate-900 rounded-full text-slate-400 group-hover:text-amber-400 transition-colors";
            document.getElementById('icon-google').setAttribute('data-lucide', 'upload-cloud');

            // Deshabilitar botón final
            const btnFinal = document.getElementById('btn-final-convert');
            btnFinal.setAttribute('disabled', 'true');
            btnFinal.className = "w-full sm:w-auto px-6 py-3.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm rounded-xl transition shadow-lg shadow-emerald-950/40 flex items-center justify-center gap-2.5 cursor-not-allowed opacity-50";

            hideNotification();
            switchPreviewTab('meta');
            lucide.createIcons();
            showNotification('info', 'La aplicación se ha reiniciado correctamente.');
        }
    </script>
